# نموذج أسرار الـAPI — انسخه إلى .env.deploy-api وعدّل القيم ثم npm run pack:api
# الملف .env.deploy-api مستثنى من Git. لا تضع علامات اقتباس حول المفاتيح ولا مسافات زائدة.
PORT=8080
NODE_ENV=production
COOKIE_SAME_SITE=lax
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
REDIS_URL=rediss://default:<password>@<host>:<port>
INTERNAL_API_KEY=<سر طويل عشوائي، نفس قيمة البوت>
SESSION_SECRET=<32 حرفًا عشوائيًا على الأقل>
PUBLIC_API_URL=https://3pal-api.discloud.app
PUBLIC_SITE_URL=https://<your-domain>
PUBLIC_SITE_ORIGINS=https://<your-domain>,https://<project>.vercel.app
MAX_SSE_CLIENTS=500
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://<your-domain>/auth/discord/callback
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_CHANNEL_ID=
DISCORD_DAILY_CHANNEL_ID=
DISCORD_LFG_CHANNEL_ID=
DISCORD_LFG_CATEGORY_ID=
DISCORD_REPORT_CHANNEL_ID=
TRADE_CHANNEL_ID=
ADMIN_ROLE_IDS=
DISCORD_OWNER_ID=
ZARK_TAGLINE=3Pal Games — فريقك أقرب مما تتخيل
PRISMA_HIDE_UPDATE_MESSAGE=1
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
