generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  SCHEDULED
  OPEN
  FULL
  ACTIVE
  COMPLETED
  CLOSED
  EXPIRED
}

enum LfgRoomSource {
  MANUAL
  AUTO
}

enum ZarkGameKind {
  RACE
  DUEL
  CHAIN
  POLL
}

enum MatchStatus {
  OPEN
  COMPLETED
  EXPIRED
  CANCELLED
}

enum GameSessionStatus {
  WAITING
  READY
  RUNNING
  PAUSED
  FINISHED
  CANCELLED
}

enum GameSessionMemberRole {
  PLAYER
  SPECTATOR
}

enum GameSessionMemberStatus {
  JOINED
  READY
  WAITING_NEXT
  LEFT
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
  DISMISSED
}

enum ReportMessageRole {
  USER
  ADMIN
  SYSTEM
}

enum LfgMemberStatus {
  ACTIVE
  LEFT
  COMPLETED
  KICKED
}

enum GameInterestStatus {
  INTERESTED
  NOT_INTERESTED
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum QuestionMediaType {
  TEXT
  IMAGE
}

enum GameQuestionOrigin {
  BUILT_IN
  ADMIN
}

enum NotificationDeliveryStatus {
  RESERVED
  SENT
  IGNORED
  FAILED
}

enum AvailabilityActivity {
  FREE
  PLAYING
  STUDYING
  WORKING
  BUSY
  SLEEPING
  AWAY
}

enum SecurityActionType {
  MEMBER_BAN
  MEMBER_KICK
  MEMBER_TIMEOUT
  MEMBER_TIMEOUT_REMOVED
  ROLE_ADDED
  ROLE_REMOVED
  ROLE_CREATED
  ROLE_DELETED
  ROLE_UPDATED
  CHANNEL_CREATED
  CHANNEL_DELETED
  CHANNEL_UPDATED
  WEBHOOK_CREATED
  WEBHOOK_DELETED
  WEBHOOK_UPDATED
  BOT_ADDED
  UNKNOWN
}

enum SecuritySeverity {
  INFO
  WARNING
  CRITICAL
}

enum AdminSuspensionStatus {
  SUSPENDED
  RESTORED
}

enum MentionPolicy {
  EVERYONE
  INTERESTED_ONLY
  NOBODY
}

enum TradeStatus {
  OPEN
  PENDING
  COMPLETION_PENDING
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
  REMOVED
}

enum TradeInterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum TradeConversationStatus {
  OPEN
  CLOSED
  DISPUTED
}

enum TradeReportStatus {
  OPEN
  REVIEWING
  DISMISSED
  ACTIONED
}

enum AdminBroadcastStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum TradeReportReason {
  SCAM_FRAUD
  HARASSMENT
  MISLEADING_TRADE
  SPAM
  PROHIBITED_CONTENT
  OTHER
}

enum TradeNotificationType {
  INTEREST_NEW
  INTEREST_ACCEPTED
  INTEREST_DECLINED
  MESSAGE_NEW
  TRADE_STATUS
  REPORT_UPDATED
}

model BotIdentity {
  id        Int      @id @default(1)
  name      String   @default("Zark LFG System")
  tagline   String   @default("Zark LFG System — فريقك أقرب مما تتخيل")
  updatedAt DateTime @updatedAt
}

model GuildSettings {
  guildId                      String    @id
  lfgChannelId                 String?
  lfgCategoryId                String?
  publicChannelId              String?
  dailyChannelId               String?
  leaderboardChannelId         String?
  reportChannelId              String?
  websiteUrl                   String    @default("https://zark-ps.com")
  dmNotificationsEnabled       Boolean   @default(true)
  quickMatchEnabled            Boolean   @default(true)
  autoSmartRoomsEnabled        Boolean   @default(false)
  autoRoomIntervalMinutes      Int       @default(120)
  autoRoomMinimumInterested    Int       @default(2)
  autoRoomLifetimeMinutes      Int       @default(120)
  maxAutoRoomsPerGame          Int       @default(1)
  autoRoomDmInterestedUsers    Boolean   @default(true)
  deleteExpiredAutoRooms       Boolean   @default(true)
  voiceEmptyGraceMinutes       Int       @default(10)
  singlePlayerIdleMinutes      Int       @default(15)
  waitingSessionTimeoutMinutes Int       @default(120)
  ratingsEnabled               Boolean   @default(true)
  reportsEnabled               Boolean   @default(true)
  autoCreateRoomChannels       Boolean   @default(true)
  maxDmPerDay                  Int       @default(3)
  notificationCooldownMinutes  Int       @default(20)
  maxActiveRoomsPerUser        Int       @default(1)
  defaultRoomDurationMinutes   Int       @default(60)
  roomGraceMinutes             Int       @default(5)
  aiChatEnabled                Boolean   @default(true)
  aiDailyMessagesPerUser       Int       @default(60)
  aiGlobalDailyMessages        Int       @default(5000)
  aiDailyTokenBudgetPerUser    Int       @default(50000)
  aiGlobalDailyTokenBudget     Int       @default(1000000)
  aiMaxOutputTokens            Int       @default(250)
  loyaltyBoostUntil            DateTime?
  loyaltyBoostMultiplier       Int       @default(1)
  updatedBy                    String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
}

model User {
  id                        String                 @id
  displayName               String
  avatarUrl                 String?
  bio                       String?
  profileAccent             String                 @default("#e50914")
  activityVisible           Boolean                @default(true)
  rivalNotificationsEnabled Boolean                @default(true)
  currentActivity           AvailabilityActivity   @default(AWAY)
  activityUntil             DateTime?
  activityNote              String?
  mentionPolicy             MentionPolicy          @default(INTERESTED_ONLY)
  xp                        Int                    @default(0)
  wins                      Int                    @default(0)
  streak                    Int                    @default(0)
  loyaltyPoints             Int                    @default(0)
  lifetimeLoyaltyPoints     Int                    @default(0)
  vipUnlocked               Boolean                @default(false)
  submittedReportCount      Int                    @default(0)
  tutorialCompleted         Boolean                @default(false)
  tutorialCompletedAt       DateTime?
  tutorialVersion           Int                    @default(0)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  points                    EngagementPoint[]
  trustScore                TrustScore?
  gameProfiles              GameProfile[]
  matchResults              ZarkMatchResult[]
  hostedRooms               LfgRoom[]              @relation("HostRooms")
  memberships               LfgMember[]
  answers                   DailyAnswer[]
  preferences               UserGamePreference[]
  bugReports                BugReport[]
  reportsFiled              Report[]               @relation("ReportsFiled")
  reportsReceived           Report[]               @relation("ReportsReceived")
  reportMessages            ReportMessage[]
  aiUsage                   AiUsageDaily[]
  weeklyAvailability        UserAvailability[]
  roomRatings               LfgRoomRating[]
  loyaltyTransactions       LoyaltyTransaction[]
  ownedTrades               Trade[]                @relation("TradeOwner")
  tradeInterests            TradeInterest[]
  ownedTradeConversations   TradeConversation[]    @relation("TradeConversationOwner")
  joinedTradeConversations  TradeConversation[]    @relation("TradeConversationInterested")
  tradeMessages             TradeMessage[]
  tradeMessageRevisions     TradeMessageRevision[]
  tradeReportsFiled         TradeReport[]          @relation("TradeReportReporter")
  tradeReportsReceived      TradeReport[]          @relation("TradeReportReportedUser")
  tradeReviewsWritten       TradeReview[]          @relation("TradeReviewAuthor")
  tradeReviewsReceived      TradeReview[]          @relation("TradeReviewTarget")
  tradeNotifications        TradeNotification[]    @relation("TradeNotificationUser")
  tradeNotificationsActed   TradeNotification[]    @relation("TradeNotificationActor")
  tradeAuditEntries         TradeAuditLog[]
}

model LoyaltyTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int
  reason       String
  referenceKey String   @unique
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserAvailability {
  id          String               @id @default(cuid())
  userId      String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  activity    AvailabilityActivity @default(FREE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek, startMinute, endMinute])
  @@index([dayOfWeek, startMinute, endMinute])
}

model TrustScore {
  userId          String   @id
  score           Float    @default(1)
  rejectedReports Int      @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ZarkGameCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  icon      String?
  sortOrder Int        @default(0)
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  games     ZarkGame[]
}

model ZarkGame {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  kind        ZarkGameKind
  enabled     Boolean          @default(true)
  basePoints  Int              @default(100)
  icon        String?
  imageData   String?
  category    String           @default("RACE")
  categoryId  String?
  aliases     String[]         @default([])
  minPlayers                  Int     @default(1)
  maxPlayers                  Int     @default(25)
  roundDurationSeconds        Int     @default(15)
  lobbyEnabled                Boolean @default(false)
  autoStart                   Boolean @default(true)
  readyCheckEnabled           Boolean @default(false)
  allowLateJoin               Boolean @default(true)
  skipEnabled                 Boolean @default(true)
  skipVotePercent             Int     @default(51)
  hostSkipOverride            Boolean @default(true)
  allowReplay                 Boolean @default(true)
  questionCooldownSeconds     Int     @default(1)
  recentQuestionHistorySize   Int     @default(30)
  settings                    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  categoryRef ZarkGameCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  profiles    GameProfile[]
  matches     ZarkMatch[]
  sessions    ZarkGameSession[]
  challenges  DailyChallenge[]
  questions   GameQuestion[]
}

model GameQuestion {
  id              String            @id @default(cuid())
  gameId          String
  prompt          String
  acceptedAnswers String[]
  mediaType       QuestionMediaType @default(TEXT)
  mediaUrl        String?
  difficulty      Int               @default(1)
  enabled         Boolean           @default(true)
  origin          GameQuestionOrigin @default(ADMIN)
  sourceKey       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  game            ZarkGame          @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, enabled, difficulty])
  @@unique([gameId, sourceKey])
}

model GameProfile {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  xp        Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  streak    Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      ZarkGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model ZarkMatch {
  id               String            @id @default(cuid())
  gameId           String
  seriesId         String?
  channelId        String?
  activeChannelKey String?           @unique
  roundNumber      Int               @default(1)
  totalRounds      Int               @default(1)
  prompt           String
  answer           String
  choices          String[]          @default([])
  hintUserIds      String[]          @default([])
  mediaUrl         String?
  status           MatchStatus       @default(OPEN)
  durationMs       Int               @default(60000)
  startedAt        DateTime          @default(now())
  endsAt           DateTime
  lockExpiresAt    DateTime?
  sessionId        String?
  questionKey      String?
  game             ZarkGame          @relation(fields: [gameId], references: [id])
  session          ZarkGameSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  results          ZarkMatchResult[]

  @@unique([seriesId, roundNumber])
  @@index([gameId, startedAt])
  @@index([channelId, startedAt])
  @@index([sessionId, roundNumber])
}

model ZarkGameSession {
  id                    String            @id @default(cuid())
  gameId                String
  guildId               String
  channelId             String
  activeChannelKey      String?           @unique
  hostId                String
  status                GameSessionStatus @default(WAITING)
  currentRound          Int               @default(0)
  totalRounds           Int               @default(1)
  currentMatchId        String?
  messageId             String?
  recentQuestionKeys    String[]          @default([])
  lobbyEnabled          Boolean           @default(false)
  autoStart             Boolean           @default(true)
  readyCheckEnabled     Boolean           @default(false)
  allowLateJoin         Boolean           @default(true)
  skipEnabled           Boolean           @default(true)
  skipVotePercent       Int               @default(51)
  hostSkipOverride      Boolean            @default(true)
  allowReplay           Boolean           @default(true)
  minPlayers            Int               @default(1)
  maxPlayers            Int               @default(25)
  durationMs            Int               @default(15000)
  questionCooldownMs    Int               @default(1000)
  historySize           Int               @default(30)
  startedAt             DateTime?
  endedAt               DateTime?
  expiresAt             DateTime
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  game                  ZarkGame          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  members               ZarkGameSessionMember[]
  matches               ZarkMatch[]
  skipVotes             ZarkSkipVote[]

  @@index([guildId, channelId, status])
  @@index([expiresAt, status])
}

model ZarkGameSessionMember {
  id              String                  @id @default(cuid())
  sessionId       String
  userId          String
  displayName     String
  role            GameSessionMemberRole   @default(PLAYER)
  status          GameSessionMemberStatus @default(JOINED)
  joinedAt        DateTime                @default(now())
  readyAt         DateTime?
  leftAt          DateTime?
  replayRequested Boolean                 @default(false)
  session         ZarkGameSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId, status])
}

model ZarkSkipVote {
  id        String          @id @default(cuid())
  sessionId String
  matchId   String
  userId    String
  createdAt DateTime        @default(now())
  session   ZarkGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, matchId, userId])
  @@index([sessionId, matchId])
}

model ZarkMatchResult {
  id        String    @id @default(cuid())
  matchId   String
  userId    String
  rank      Int
  elapsedMs Int
  points    Int
  createdAt DateTime  @default(now())
  match     ZarkMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, rank])
}

model EngagementPoint {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  source    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId, createdAt])
}

model DailyChallenge {
  id         String        @id @default(cuid())
  dayKey     String        @unique
  gameId     String
  prompt     String
  answer     String
  basePoints Int           @default(100)
  durationMs Int           @default(60000)
  startedAt  DateTime      @default(now())
  endsAt     DateTime
  game       ZarkGame      @relation(fields: [gameId], references: [id])
  answers    DailyAnswer[]
}

model DailyAnswer {
  id          String         @id @default(cuid())
  challengeId String
  userId      String
  rank        Int
  elapsedMs   Int
  points      Int
  answeredAt  DateTime       @default(now())
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@unique([challengeId, rank])
  @@index([challengeId, answeredAt])
}

model LfgGameCategory {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  icon      String?
  sortOrder Int              @default(0)
  games     LfgGameCatalog[]
}

model LfgGameCatalog {
  id               String               @id @default(cuid())
  slug             String               @unique
  name             String
  description      String?
  icon             String?
  category         String?
  categoryId       String?
  minPlayers       Int                  @default(2)
  maxPlayers       Int                  @default(10)
  autoMinAvailable Int?
  sortOrder        Int                  @default(0)
  enabled          Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  gameCategory     LfgGameCategory?     @relation(fields: [categoryId], references: [id])
  rooms            LfgRoom[]
  preferences      UserGamePreference[]
  trades           Trade[]

  @@index([categoryId, enabled, sortOrder])
}

model Trade {
  id                       String              @id @default(cuid())
  publicId                 Int                 @unique @default(autoincrement())
  ownerId                  String
  lfgGameId                String
  itemName                 String
  imageData                String
  thumbnailData            String?
  haveText                 String
  wantText                 String
  description              String?
  status                   TradeStatus         @default(OPEN)
  completionRequestedBy    String?
  completionConversationId String?
  expiresAt                DateTime?
  closedAt                 DateTime?
  discordChannelId         String?
  discordMessageId         String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  owner                    User                @relation("TradeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  game                     LfgGameCatalog      @relation(fields: [lfgGameId], references: [id])
  interests                TradeInterest[]
  conversations            TradeConversation[]
  reports                  TradeReport[]
  reviews                  TradeReview[]
  notifications            TradeNotification[]
  auditEntries             TradeAuditLog[]

  @@index([status, createdAt])
  @@index([ownerId, status, updatedAt])
  @@index([lfgGameId, status, createdAt])
}

model TradeInterest {
  id           String              @id @default(cuid())
  tradeId      String
  userId       String
  status       TradeInterestStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  trade        Trade               @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation TradeConversation?

  @@unique([tradeId, userId])
  @@index([tradeId, status, createdAt])
  @@index([userId, status, updatedAt])
}

model TradeConversation {
  id               String                  @id @default(cuid())
  tradeId          String
  interestId       String                  @unique
  ownerId          String
  interestedUserId String
  status           TradeConversationStatus @default(OPEN)
  ownerReadAt      DateTime?
  interestedReadAt DateTime?
  lastMessageAt    DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  trade            Trade                   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  interest         TradeInterest           @relation(fields: [interestId], references: [id], onDelete: Cascade)
  owner            User                    @relation("TradeConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  interestedUser   User                    @relation("TradeConversationInterested", fields: [interestedUserId], references: [id], onDelete: Cascade)
  messages         TradeMessage[]
  reports          TradeReport[]
  reviews          TradeReview[]
  notifications    TradeNotification[]
  auditEntries     TradeAuditLog[]

  @@unique([tradeId, interestedUserId])
  @@index([ownerId, lastMessageAt])
  @@index([interestedUserId, lastMessageAt])
}

model TradeMessage {
  id             String                 @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())
  conversation   TradeConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  revisions      TradeMessageRevision[]
  reports        TradeReport[]
  auditEntries   TradeAuditLog[]

  @@index([conversationId, createdAt])
}

model TradeMessageRevision {
  id              String       @id @default(cuid())
  messageId       String
  actorId         String
  previousContent String
  action          String
  createdAt       DateTime     @default(now())
  message         TradeMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actor           User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model TradeReport {
  id             String             @id @default(cuid())
  tradeId        String
  conversationId String?
  messageId      String?
  reporterId     String
  reportedUserId String?
  reason         TradeReportReason
  details        String?
  evidence       Json
  status         TradeReportStatus  @default(OPEN)
  resolution     String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  trade          Trade              @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  conversation   TradeConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        TradeMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reporter       User               @relation("TradeReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?              @relation("TradeReportReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([tradeId, createdAt])
  @@index([reporterId, createdAt])
}

model TradeReview {
  id             String            @id @default(cuid())
  tradeId        String
  conversationId String
  reviewerId     String
  reviewedUserId String
  rating         Int
  comment        String?
  createdAt      DateTime          @default(now())
  trade          Trade             @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  conversation   TradeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reviewer       User              @relation("TradeReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser   User              @relation("TradeReviewTarget", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@unique([tradeId, reviewerId, reviewedUserId])
  @@index([reviewedUserId, createdAt])
}

model TradeNotification {
  id             String                @id @default(cuid())
  userId         String
  actorId        String?
  tradeId        String?
  conversationId String?
  type           TradeNotificationType
  title          String
  body           String
  readAt         DateTime?
  dmReservedAt   DateTime?
  dmSentAt       DateTime?
  createdAt      DateTime              @default(now())
  user           User                  @relation("TradeNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?                 @relation("TradeNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  trade          Trade?                @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  conversation   TradeConversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model TradeAuditLog {
  id             String             @id @default(cuid())
  actorId        String
  action         String
  tradeId        String?
  conversationId String?
  messageId      String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  actor          User               @relation(fields: [actorId], references: [id], onDelete: Cascade)
  trade          Trade?             @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  conversation   TradeConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        TradeMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([tradeId, createdAt])
  @@index([conversationId, createdAt])
  @@index([actorId, createdAt])
}

model UserGamePreference {
  userId               String
  lfgGameId            String
  interestStatus       GameInterestStatus @default(INTERESTED)
  notificationsEnabled Boolean            @default(true)
  autoInvitesEnabled   Boolean            @default(true)
  mutedUntil           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                 LfgGameCatalog     @relation(fields: [lfgGameId], references: [id], onDelete: Cascade)

  @@id([userId, lfgGameId])
  @@index([lfgGameId, interestStatus, notificationsEnabled])
}

model NotificationDelivery {
  id        String                     @id @default(cuid())
  userId    String
  lfgGameId String
  roomId    String
  status    NotificationDeliveryStatus @default(RESERVED)
  dedupeKey String                     @unique
  createdAt DateTime                   @default(now())
  sentAt    DateTime?
  ignoredAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, lfgGameId, createdAt])
  @@index([roomId, status])
}

model LfgRoom {
  id                  String          @id @default(cuid())
  hostId              String
  lfgGameId           String
  title               String?
  description         String?
  gameMode            String?
  mapName             String?
  needsVoice          Boolean         @default(true)
  maxPlayers          Int             @default(2)
  durationMinutes     Int             @default(60)
  memberCount         Int             @default(1)
  version             Int             @default(1)
  status              RoomStatus      @default(OPEN)
  source              LfgRoomSource   @default(MANUAL)
  locked              Boolean         @default(false)
  roomEmoji           String?         @default("🎮")
  accentColor         String          @default("#e50914")
  voiceChannelId      String?
  textChannelId       String?
  categoryId          String?
  controlMessageId    String?
  listingChannelId    String?
  listingMessageId    String?         @unique
  createdAt           DateTime        @default(now())
  scheduledFor        DateTime?
  readyNotifiedAt     DateTime?
  reminderDeliveredAt DateTime?
  attendanceWarningAt DateTime?
  startedAt           DateTime?
  playEndsAt          DateTime?
  emptySince          DateTime?
  lastVoiceActivityAt DateTime?
  singlePlayerSince   DateTime?
  idleWarningAt       DateTime?
  expiresAt           DateTime?
  autoDeleteAt        DateTime?
  completedAt         DateTime?
  closedAt            DateTime?
  channelsDeletedAt   DateTime?
  ratingRequestedAt   DateTime?
  host                User            @relation("HostRooms", fields: [hostId], references: [id])
  lfgGame             LfgGameCatalog  @relation(fields: [lfgGameId], references: [id])
  members             LfgMember[]
  ratings             LfgRoomRating[]

  @@index([lfgGameId, status, createdAt])
  @@index([listingChannelId, status])
  @@index([status, autoDeleteAt])
  @@index([status, scheduledFor])
  @@index([status, attendanceWarningAt])
  @@index([status, playEndsAt])
  @@index([status, ratingRequestedAt, completedAt])
}

model LfgMember {
  roomId        String
  userId        String
  status        LfgMemberStatus @default(ACTIVE)
  joinedAt      DateTime        @default(now())
  leftAt        DateTime?
  completedAt   DateTime?
  ratingRequestedAt DateTime?
  voiceJoinedAt DateTime?
  voiceSeconds  Int             @default(0)
  played        Boolean         @default(false)
  room          LfgRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId, status])
  @@index([roomId, voiceJoinedAt])
  @@index([status, ratingRequestedAt])
}

model AiUsageDaily {
  id             String   @id @default(cuid())
  userId         String
  dayKey         String
  requestCount   Int      @default(0)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  reservedTokens Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([dayKey, requestCount])
}

model ServiceHeartbeat {
  service    String   @id
  instanceId String?
  metadata   Json?
  lastSeenAt DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  raterId   String
  ratedId   String
  sessionId String
  stars     Int
  tags      String[]
  createdAt DateTime @default(now())

  @@unique([raterId, sessionId, ratedId])
  @@index([ratedId, createdAt])
  @@index([sessionId, ratedId])
}

model LfgRoomRating {
  id        String   @id @default(cuid())
  roomId    String
  raterId   String
  stars     Int
  createdAt DateTime @default(now())
  room      LfgRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  rater     User     @relation(fields: [raterId], references: [id], onDelete: Cascade)

  @@unique([roomId, raterId])
  @@index([roomId, createdAt])
}

model Report {
  id                          String          @id @default(cuid())
  reporterId                  String
  reportedId                  String
  sessionId                   String?
  reason                      String
  description                 String?
  status                      ReportStatus    @default(PENDING)
  resolvedBy                  String?
  resolvedAt                  DateTime?
  reporterViewingUntil        DateTime?
  reporterNotificationPending Boolean         @default(false)
  reporterLastReadAt          DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  reporter                    User            @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reported                    User            @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  messages                    ReportMessage[]

  @@index([reportedId, status, createdAt])
  @@index([reporterId, createdAt])
  @@index([sessionId, reporterId])
}

model BugReport {
  id                          String          @id @default(cuid())
  reporterId                  String
  title                       String
  description                 String
  context                     String?
  status                      BugReportStatus @default(OPEN)
  resolvedBy                  String?
  resolvedAt                  DateTime?
  reporterViewingUntil        DateTime?
  reporterNotificationPending Boolean         @default(false)
  reporterLastReadAt          DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  reporter                    User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  messages                    ReportMessage[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model ReportMessage {
  id             String            @id @default(cuid())
  playerReportId String?
  bugReportId    String?
  authorId       String
  authorName     String
  authorRole     ReportMessageRole
  message        String
  createdAt      DateTime          @default(now())
  playerReport   Report?           @relation(fields: [playerReportId], references: [id], onDelete: Cascade)
  bugReport      BugReport?        @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  author         User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([playerReportId, createdAt])
  @@index([bugReportId, createdAt])
  @@index([authorId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())
}

model AdminBroadcast {
  id           String               @id @default(cuid())
  adminId      String
  title        String
  content      String
  status       AdminBroadcastStatus @default(PENDING)
  totalMembers Int                  @default(0)
  sentCount    Int                  @default(0)
  failedCount  Int                  @default(0)
  skippedCount Int                  @default(0)
  lastError    String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([adminId, createdAt])
}

// Per-guild settings deliberately live in the existing PostgreSQL database.
// Discord user IDs are strings; no client-controlled ownership is stored here.
model SecuritySettings {
  guildId                  String   @id
  enabled                  Boolean  @default(true)
  maxBansPerHour           Int      @default(2)
  maxTimeoutsPerHour       Int      @default(2)
  maxKicksPerHour          Int      @default(5)
  maxRoleChangesPerHour    Int      @default(8)
  maxChannelDeletesPerHour Int      @default(3)
  maxWebhookChangesPerHour Int      @default(3)
  ownerDmAlertsEnabled     Boolean  @default(true)
  securityLogChannelId     String?
  // Selected people may run role/channel/webhook maintenance and timeouts.
  // Bans and kicks are deliberately never exempted.
  operationalExemptUserIds String[] @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  actions     SecurityAction[]
  suspensions AdminSuspension[]
  alerts      SecurityAlert[]
}

model SecurityAction {
  id         String             @id @default(cuid())
  guildId    String
  executorId String?
  targetId   String?
  actionType SecurityActionType
  severity   SecuritySeverity   @default(INFO)
  timestamp  DateTime           @default(now())
  auditLogId String?
  reason     String?
  metadata   Json?
  createdAt  DateTime           @default(now())
  settings   SecuritySettings   @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, auditLogId])
  @@index([guildId, executorId, actionType, timestamp])
  @@index([guildId, timestamp])
}

model AdminSuspension {
  id            String                @id @default(cuid())
  guildId       String
  userId        String
  reason        String
  trigger       SecurityActionType
  status        AdminSuspensionStatus @default(SUSPENDED)
  actionCounts  Json?
  suspendedAt   DateTime              @default(now())
  restoredAt    DateTime?
  restoredBy    String?
  settings      SecuritySettings      @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  roleSnapshots AdminRoleSnapshot[]

  @@unique([guildId, userId])
  @@index([guildId, status, suspendedAt])
}

model AdminRoleSnapshot {
  id           String          @id @default(cuid())
  suspensionId String
  roleId       String
  roleName     String?
  createdAt    DateTime        @default(now())
  suspension   AdminSuspension @relation(fields: [suspensionId], references: [id], onDelete: Cascade)

  @@unique([suspensionId, roleId])
}

model SecurityAlert {
  id             String           @id @default(cuid())
  guildId        String
  severity       SecuritySeverity
  title          String
  message        String
  actionId       String?
  suspensionId   String?
  acknowledgedAt DateTime?
  createdAt      DateTime         @default(now())
  settings       SecuritySettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, severity, createdAt])
}
