{
  "name": "zark-lfg-game",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Zark — منصة تنافسية لإحياء مجتمع Discord",
  "scripts": {
    "start": "npm run db:push:deploy && node scripts/start-services.mjs",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:bot": "tsx apps/bot/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test packages/**/*.test.ts",
    "test:reports": "tsx scripts/report-ticket-smoke.ts",
    "test:ai-actions": "tsx scripts/ai-actions-smoke.ts",
    "test:admin-games": "tsx scripts/admin-game-content-smoke.ts",
    "test:ai-failover": "tsx scripts/ai-failover-smoke.ts",
    "test:games": "tsx scripts/smoke-games-availability.ts",
    "opera:gx:start": "node scripts/opera-gx-cdp.mjs start",
    "opera:gx:status": "node scripts/opera-gx-cdp.mjs status",
    "opera:gx:test": "node scripts/opera-gx-smoke.mjs",
    "opera:gx:ready": "npm run opera:gx:start && npm run opera:gx:test",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:prepare": "prisma db execute --file packages/db/prisma/safe-zark-series.sql --schema packages/db/prisma/schema.prisma",
    "db:push": "npm run db:prepare && prisma db push --schema packages/db/prisma/schema.prisma",
    "db:push:deploy": "npm run db:prepare && prisma db push --skip-generate --schema packages/db/prisma/schema.prisma",
    "check": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.12.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "jose": "^6.1.0",
    "playwright": "^1.62.1",
    "prisma": "^6.12.0",
    "redis": "^5.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
