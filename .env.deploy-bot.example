# نموذج أسرار البوت (Wispbyte أو Discloud) — انسخه إلى .env.deploy-bot وعدّل القيم ثم npm run pack:bot
# الملف .env.deploy-bot مستثنى من Git.
# لا يوجد DATABASE_URL: البوت لا يلمس قاعدة البيانات إطلاقًا، وكل عملياته عبر الـAPI.
REDIS_URL="rediss://default:<password>@<host>:<port>"
INTERNAL_API_URL="https://3pal-api.onrender.com"
INTERNAL_API_KEY="<نفس قيمة الـAPI>"
PUBLIC_API_URL="https://3pal-api.onrender.com"
PUBLIC_SITE_URL="https://<your-domain>"
DISCORD_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_CLIENT_ID=""
DISCORD_PUBLIC_CHANNEL_ID=""
DISCORD_DAILY_CHANNEL_ID=""
DISCORD_LFG_CHANNEL_ID=""
DISCORD_LFG_CATEGORY_ID=""
DISCORD_REPORT_CHANNEL_ID=""
TRADE_CHANNEL_ID=""
DISCORD_HACK_ALERT_CHANNEL_ID=""
ADMIN_ROLE_IDS=""
DISCORD_OWNER_ID=""
ZARK_TAGLINE="3Pal Games — فريقك أقرب مما تتخيل"
